                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Each cell is a brand-affinity index — 100 = the national average; 150 means this screen's audience is 1.5× more likely than the average person in Ireland to have that affinity; below 100 = less likely. Darker = higher. It reflects how concentrated the audience is, not a headcount.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Layout",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#333333"
                    }
                  },
                  {
                    "value": " — rows are screens; columns are the hour of day (00–23); the Total column is the day-level average, and screens are sorted by it.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The slicers",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#0a7fa8"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Category",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#333333"
                    }
                  },
                  {
                    "value": " — picks the category to explore; shared with the Category ranking tab, so changing it here updates that tab too.",
                    "textStyle": {
