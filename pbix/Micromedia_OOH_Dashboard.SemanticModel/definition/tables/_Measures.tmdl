				    "#,##0"
				)

	measure 'Movement Population (Hourly)' =
			VAR _mv = SELECTEDVALUE ( 'Demo Movement'[MovementKey], "All" )
			RETURN
			IF (
			    _mv = "All",
			    [Total Population (Hourly)],
			    SUMX (
			        SUMMARIZE (
			            FILTER ( Footfall, Footfall[IS_GRAND_TOTAL] = 1 && Footfall[HOUR] <> 25 && Footfall[HasValidSite] = TRUE () ),
			            Footfall[SITE_ID], Footfall[YEAR_MONTH], Footfall[HOUR]
			        ),
			        VAR _tot = CALCULATE ( SUM ( Footfall[EXTRAPOLATED_USERS_2] ), Footfall[IS_GRAND_TOTAL] = 1 )
			        VAR _ped = CALCULATE ( SUM ( Footfall[EXTRAPOLATED_USERS_2] ), Footfall[IS_GRAND_TOTAL] = 0, Footfall[VISITATION_MODALITY] = "All", Footfall[Movement Group] = "Pedestrians" )
			        VAR _non = CALCULATE ( SUM ( Footfall[EXTRAPOLATED_USERS_2] ), Footfall[IS_GRAND_TOTAL] = 0, Footfall[VISITATION_MODALITY] = "All", Footfall[Movement Group] = "Non_Pedestrians" )
			        VAR _sh  = DIVIDE ( _ped, _ped + _non )
			        RETURN _tot * IF ( _mv = "Pedestrians", _sh, 1 - _sh )
			    )
			)
		formatString: #,0
		displayFolder: Age&Gender\Display
		lineageTag: 28d0e1ec-141b-45c9-b862-e441ab6336a1

	measure '_Mov Share' =
			VAR _k = SELECTEDVALUE ( 'Demo Movement'[MovementKey], "All" )
			VAR _ped = CALCULATE ( SUM ( Footfall[EXTRAPOLATED_USERS_2] ), Footfall[IS_GRAND_TOTAL] = 0, Footfall[HOUR] = 25, Footfall[VISITATION_MODALITY] = "All", Footfall[Movement Group] = "Pedestrians", Footfall[HasValidSite] = TRUE () )
			VAR _non = CALCULATE ( SUM ( Footfall[EXTRAPOLATED_USERS_2] ), Footfall[IS_GRAND_TOTAL] = 0, Footfall[HOUR] = 25, Footfall[VISITATION_MODALITY] = "All", Footfall[Movement Group] = "Non_Pedestrians", Footfall[HasValidSite] = TRUE () )
			RETURN
			SWITCH ( _k, "Pedestrians", DIVIDE ( _ped, _ped + _non ), "Non_Pedestrians", DIVIDE ( _non, _ped + _non ), 1 )
		displayFolder: KPIs\Segment (mov+vis)
		lineageTag: 1b86db8c-6aa3-4af0-8e06-61e8ba6ad26d

	measure '_Vis Share' =
			VAR _k = SELECTEDVALUE ( 'Demo Visitation'[VisKey], "All" )
			VAR _sel = CALCULATE ( SUM ( Footfall[EXTRAPOLATED_USERS_2] ), Footfall[IS_GRAND_TOTAL] = 0, Footfall[HOUR] = 25, Footfall[MOVEMENT_MODALITY] = "All", Footfall[VISITATION_MODALITY] = _k, Footfall[HasValidSite] = TRUE () )
			VAR _all = CALCULATE ( SUM ( Footfall[EXTRAPOLATED_USERS_2] ), Footfall[IS_GRAND_TOTAL] = 0, Footfall[HOUR] = 25, Footfall[MOVEMENT_MODALITY] = "All", Footfall[VISITATION_MODALITY] IN { "Residents", "Workers", "Transient" }, Footfall[HasValidSite] = TRUE () )
			RETURN
			IF ( _k = "All", 1, DIVIDE ( _sel, _all ) )
		displayFolder: KPIs\Segment (mov+vis)
		lineageTag: 297d9009-7d37-4fbb-a0da-49eb40350f45

	measure 'Population (mv+vis)' = [Total Population] * [_Mov Share] * [_Vis Share]
		formatString: #,0
