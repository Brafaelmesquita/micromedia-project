	measure 'Affinity Index (weighted)' =
			
			VAR T =
			    ADDCOLUMNS (
			        VALUES ( Brand_Affinity[SITE_ID] ),
			        "Idx", CALCULATE ( AVERAGE ( Brand_Affinity[BRAND_AFFINITY_INDEX] ), Brand_Affinity[IS_DEFAULT] = 1 ),
			        "W",
			            VAR c = Brand_Affinity[SITE_ID]
			            RETURN
			                CALCULATE (
			                    SUM ( Footfall[EXTRAPOLATED_USERS_2] ),
			                    Footfall[SITE_ID] = c,
			                    Footfall[IS_GRAND_TOTAL] = 1,
			                    Footfall[HOUR] = 25,
			                    Footfall[HasValidSite] = TRUE (),
			                    REMOVEFILTERS ( dim_Hour )
			                )
			    )
			RETURN
			    DIVIDE (
			        SUMX ( FILTER ( T, NOT ISBLANK ( [Idx] ) ), [Idx] * [W] ),
			        SUMX ( FILTER ( T, NOT ISBLANK ( [Idx] ) ), [W] )
			    )
		formatString: 0
		lineageTag: af339790-9ced-492a-bb78-c7416e4a271b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

