	measure 'QA Inflation' =
			
			SWITCH (
			    SELECTEDVALUE ( 'Dim Metric'[Metric] ),
			    "Dwell Time",             [Dwell Time (Ratio)],
			    "Ext Signals",            [Ext Signals (Inflation)],
			    "Ext Signals 2",          [Ext Signals 2 (Inflation)],
			    "Eye Contacts",           [Eye Contacts (Inflation)],
			    "Eye Contacts Weighted",  [Eye Contacts Weighted (Inflation)],
			    "Impressions Weighted",   [Impressions Weighted (Inflation)],
			    "Impressions Weighted 2", [Impressions Weighted 2 (Inflation)],
			    "Signals",                [Signals (Inflation)],
			    "EXTRAPOLATED_NUMBER_OF_USERS",        [PaS (Inflation)],
			    "EXTRAPOLATED_USERS_2",                [Total Population (Inflation)],
			    "EXTRAPOLATED_NUMBER_OF_EYE_CONTACTS", [OTS (Inflation)],
