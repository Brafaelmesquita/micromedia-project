	measure 'Median Brand Affinity Index' =
			
			CALCULATE ( MEDIAN ( Brand_Affinity[BRAND_AFFINITY_INDEX] ), Brand_Affinity[IS_DEFAULT] = 1 )
		lineageTag: c7a302db-0297-4c33-8bff-dcb61faa1485

