	measure 'OTS (mv+vis)' = [OTS] * [_Mov Share] * [_Vis Share]
		formatString: #,0
		displayFolder: KPIs\Segment (mov+vis)
		lineageTag: 0ce05ae5-27fb-4e5c-990d-d0a31ea755cd

	measure 'Capture Rate (mv+vis)' = DIVIDE ( [OTS (mv+vis)], [Population (mv+vis)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs\Segment (mov+vis)
		lineageTag: a18f616c-9def-4b43-abd3-a6dda51047c0

	measure 'Avg Daily Population (mv+vis)' = AVERAGEX ( VALUES ( 'Calendar'[Date] ), [Population (mv+vis)] )
		formatString: 0.0
		displayFolder: KPIs\Segment (mov+vis)
		lineageTag: 1e4b1ef2-1d1c-4717-94c4-62c67894e0ea

	measure 'Avg Daily PaS (mv+vis)' = AVERAGEX ( VALUES ( 'Calendar'[Date] ), [PaS (mv+vis)] )
		formatString: 0.0
		displayFolder: KPIs\Segment (mov+vis)
		lineageTag: c09cfb16-af2d-45f7-8e70-30f65900d17a

	measure 'Avg Daily OTS (mv+vis)' = AVERAGEX ( VALUES ( 'Calendar'[Date] ), [OTS (mv+vis)] )
		formatString: 0.0
		displayFolder: KPIs\Segment (mov+vis)
		lineageTag: a9be8464-5925-4f1a-8564-e1c5a10e05cc

	/// Population-weighted share of the audience with positive affinity to the
	/// category in context (0-100). Weighted by hourly Footfall population, IS_DEFAULT = 1.
	measure 'Affinity Reach %' =
			VAR _num =
			    SUMX (
			        FILTER ( Brand_Affinity, Brand_Affinity[IS_DEFAULT] = 1 ),
			        VAR _code = Brand_Affinity[SITE_ID]
			        VAR _ym   = Brand_Affinity[YEAR_MONTH]
			        VAR _hr   = Brand_Affinity[HOUR]
			        VAR _pop =
			            CALCULATE (
			                SUM ( Footfall[EXTRAPOLATED_USERS_2] ),
			                Footfall[SITE_ID] = _code, Footfall[YEAR_MONTH] = _ym, Footfall[HOUR] = _hr,
			                Footfall[IS_GRAND_TOTAL] = 1, Footfall[HasValidSite] = TRUE ()
			            )
			        RETURN Brand_Affinity[PROPORTION_OF_TARGET_USERS] * _pop
			    )
			VAR _den =
			    SUMX (
			        FILTER ( Brand_Affinity, Brand_Affinity[IS_DEFAULT] = 1 ),
			        VAR _code = Brand_Affinity[SITE_ID]
			        VAR _ym   = Brand_Affinity[YEAR_MONTH]
			        VAR _hr   = Brand_Affinity[HOUR]
			        RETURN
			            CALCULATE (
			                SUM ( Footfall[EXTRAPOLATED_USERS_2] ),
			                Footfall[SITE_ID] = _code, Footfall[YEAR_MONTH] = _ym, Footfall[HOUR] = _hr,
			                Footfall[IS_GRAND_TOTAL] = 1, Footfall[HasValidSite] = TRUE ()
			            )
			    )
			RETURN DIVIDE ( _num, _den )
		formatString: 0.0
		displayFolder: Brand Affinity
		lineageTag: d3a10002-1111-4aaa-8bbb-000000000002

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Estimated unique people reachable with affinity to the selected category:
	/// weighted reach share x deduplicated Total Population (HOUR = 25). Avoids the
	/// hourly overcount of summing hours. Uses a single category in context.
	measure 'Affine Reach (Population)' = DIVIDE ( [Affinity Reach %], 100 ) * [Total Population]
		formatString: #,0
		displayFolder: Brand Affinity
		lineageTag: d3a10003-1111-4aaa-8bbb-000000000003

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Affine impressions: audience with affinity to the category, expressed as
	/// weighted eye-contacts (OTS). Mirrors 'Age Impressions (OTS)'. Hourly-summed,
	/// which is correct for impressions. Uses a single category in context.
	measure 'Affine Audience (OTS)' =
			SUMX (
			    FILTER ( Brand_Affinity, Brand_Affinity[IS_DEFAULT] = 1 ),
			    VAR _code = Brand_Affinity[SITE_ID]
			    VAR _ym   = Brand_Affinity[YEAR_MONTH]
			    VAR _hr   = Brand_Affinity[HOUR]
			    VAR _pct  = DIVIDE ( Brand_Affinity[PROPORTION_OF_TARGET_USERS], 100 )
			    RETURN
			        _pct *
			        CALCULATE (
			            SUM ( Footfall[EXTRAPOLATED_NUMBER_OF_EYE_CONTACTS_WEIGHTED] ),
			            Footfall[SITE_ID] = _code, Footfall[YEAR_MONTH] = _ym, Footfall[HOUR] = _hr,
			            Footfall[IS_GRAND_TOTAL] = 1
			        )
			)
		formatString: #,0
		displayFolder: Brand Affinity
		lineageTag: d3a10004-1111-4aaa-8bbb-000000000004

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Count of categories whose population-weighted index over-indexes (> 110)
	/// for the current screen/period selection.
	measure 'Categories Over-Index' =
			SUMX (
			    VALUES ( Brand_Affinity[BRAND_AFFINITY_CATEGORY_NAME] ),
			    IF ( [Affinity Index (weighted)] > 110, 1, 0 )
			)
		formatString: 0
		displayFolder: Brand Affinity
		lineageTag: d3a10005-1111-4aaa-8bbb-000000000005

	/// Strongest-affinity category (by population-weighted index) in the current selection.
	measure 'Top Affinity Category' =
			VAR _t =
			    TOPN ( 1, VALUES ( Brand_Affinity[Brand Category (short)] ), [Affinity Index (weighted)], DESC )
			RETURN CONCATENATEX ( _t, Brand_Affinity[Brand Category (short)] )
		displayFolder: Brand Affinity
		lineageTag: d3a10006-1111-4aaa-8bbb-000000000006

	/// Screen's daily audience size (Total Population), robust to the daypart slicer
	/// (ignores dim_Hour so it never conflicts with the HOUR = 25 sentinel).
	measure 'Screen Population' = CALCULATE ( [Total Population], REMOVEFILTERS ( dim_Hour ) )
		formatString: #,0
		displayFolder: Brand Affinity
		lineageTag: d3a10110-1111-4aaa-8bbb-000000000110

	/// Ranking metric combining volume and concentration: daily audience x affinity
	/// index / 100. Not a literal headcount — validate interpretation before client use.
	measure 'Affine potential' = [Screen Population] * DIVIDE ( [Avg Brand Affinity Index (seg)], 100 )
		formatString: #,0
		displayFolder: Brand Affinity
		lineageTag: d3a10111-1111-4aaa-8bbb-000000000111

	/// Affinity index for the selected audience segment (Segment slicer). Segment=All
	/// -> All+All (same as base). Movement segments force visitation=All and vice versa.
	measure 'Avg Brand Affinity Index (seg)' =
			VAR s = SELECTEDVALUE ( Segment[Segment], "All" )
			VAR mv = IF ( s = "Pedestrians" || s = "Non_Pedestrians", s, "All" )
			VAR vs = IF ( s = "Residents" || s = "Workers" || s = "Transient", s, "All" )
			RETURN
			    CALCULATE (
			        AVERAGE ( Brand_Affinity[BRAND_AFFINITY_INDEX] ),
			        Brand_Affinity[MOVEMENT_MODALITY] = mv,
			        Brand_Affinity[VISITATION_MODALITY] = vs
			    )
		formatString: 0
		displayFolder: Brand Affinity
		lineageTag: d3a10112-1111-4aaa-8bbb-000000000112

	/// % of the audience affine to the category, for the selected segment. Only varies
	/// meaningfully outside All+All (where it is ~100%).
	measure 'Proportion of Target (seg)' =
			VAR s = SELECTEDVALUE ( Segment[Segment], "All" )
			VAR mv = IF ( s = "Pedestrians" || s = "Non_Pedestrians", s, "All" )
			VAR vs = IF ( s = "Residents" || s = "Workers" || s = "Transient", s, "All" )
			RETURN
			    CALCULATE (
			        AVERAGE ( Brand_Affinity[PROPORTION_OF_TARGET_USERS] ),
			        Brand_Affinity[MOVEMENT_MODALITY] = mv,
			        Brand_Affinity[VISITATION_MODALITY] = vs
			    )
		formatString: 0
		displayFolder: Brand Affinity
		lineageTag: d3a10113-1111-4aaa-8bbb-000000000113

	/// Estimated people of the selected class segment reachable at a screen:
	/// daily audience (Total Population) x the segment's audience share (Class %).
	measure 'Reach potential' = [Total Population] * [Segment share]
		formatString: #,0
		displayFolder: Demographics
		lineageTag: d3a10401-1111-4aaa-8bbb-000000000401

	/// Share of the audience in the SELECTED segment, robust to a mismatched Breakdown
	/// slicer: it follows the chosen segment and normalises within that segment's own
	/// breakdown, so switching Breakdown never blanks the table.
	measure 'Segment share' =
			VAR seg = CALCULATE ( SELECTEDVALUE ( Demographics_ClassLong[SEGMENT] ), REMOVEFILTERS ( Demographics_ClassLong[BREAKDOWN] ) )
			VAR bd =
			    CALCULATE (
			        SELECTEDVALUE ( Demographics_ClassLong[BREAKDOWN] ),
			        REMOVEFILTERS ( Demographics_ClassLong ),
			        Demographics_ClassLong[SEGMENT] = seg
			    )
			RETURN
			    DIVIDE (
			        CALCULATE ( [Class Audience (Hourly)], REMOVEFILTERS ( Demographics_ClassLong[BREAKDOWN] ) ),
			        CALCULATE (
			            [Class Audience (Hourly)],
			            REMOVEFILTERS ( Demographics_ClassLong[SEGMENT], Demographics_ClassLong[BREAKDOWN] ),
			            Demographics_ClassLong[BREAKDOWN] = bd
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Demographics
		lineageTag: d3a10501-1111-4aaa-8bbb-000000000501

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WCshJTE7NyM9JSS1Sio0FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	changedProperty = IsHidden

	annotation PBI_ResultType = Table

